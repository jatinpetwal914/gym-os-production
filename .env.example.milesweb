# MilesWeb / cPanel production environment
# Copy names into cPanel → Setup Node.js App → Environment Variables.
# Do NOT upload a .env file. Do NOT put real keys in this file.

# --- Required: runtime ---
# public: safe to expose to the browser (inlined at build time)
NODE_ENV=production
# required, server+public: your live origin, no trailing slash, https in production
NEXT_PUBLIC_SITE_URL=

# --- Required: Supabase gymos Cloud (public) ---
# public: project URL
NEXT_PUBLIC_SUPABASE_URL=
# public: anon / publishable key (never service_role)
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# optional, public: newer publishable key if you use it instead of the anon JWT
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# --- Required: Supabase gymos Cloud (server-only) ---
# server-only: same project URL as NEXT_PUBLIC_SUPABASE_URL
SUPABASE_URL=
# server-only REQUIRED: service_role / secret key
# Used for username login lookup and Auth admin. Never prefix with NEXT_PUBLIC_
SUPABASE_SERVICE_ROLE_KEY=

# --- Optional: music ---
# server-only, optional: audius | pixabay
MUSIC_PROVIDER=
# server-only, optional
AUDIUS_API_KEY=
# server-only, optional
PIXABAY_API_KEY=

# --- PayU (server-only) ---
# Do not prefix with NEXT_PUBLIC_. Add values in cPanel only.
PAYU_MERCHANT_KEY=
PAYU_MERCHANT_SALT=
PAYU_ENVIRONMENT=test

# --- Gym OS registration and password setup emails (server-only) ---
# Never prefix with NEXT_PUBLIC_. Add SMTP_PASSWORD in cPanel only. Do not put it in Git.
# Paste the mailbox password exactly. If it contains a comma, do not split it into two values.
# Do not wrap SMTP_FROM or SMTP_PASSWORD in extra quotes in cPanel.
SMTP_HOST=mail.gymnasium.caumas.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=info@gymnasium.caumas.com
SMTP_FROM=Gym OS / CAUMAS <info@gymnasium.caumas.com>
SMTP_CAUMAS_TO=caumasofficial@gmail.com
SMTP_PASSWORD=

# PORT is assigned by MilesWeb/Passenger. Do not hardcode it here.