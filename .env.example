# Environment Variables for ForgeGym
# Copy this file to .env and fill in the values from gymos Project (Cloud).
# Do NOT point the app at 127.0.0.1:54321 for the production database.
# Do NOT put real keys, JWTs, passwords, or salts in this file.

# Application
NODE_ENV=production
PORT=3000

# Database — gymos Project only (https://khygsyfugymapapzfkue.supabase.co)
# SERVICE_ROLE is server-only (Auth admin / username lookup). Tenant queries use the user session.
SUPABASE_URL=https://khygsyfugymapapzfkue.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
NEXT_PUBLIC_SUPABASE_URL=https://khygsyfugymapapzfkue.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Optional: NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-key
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Global Gym Music Player
# SERVER-ONLY. Do NOT prefix with NEXT_PUBLIC_
MUSIC_PROVIDER=audius
AUDIUS_API_KEY=

# PayU Payment Gateway — server-only. Never prefix with NEXT_PUBLIC_.
PAYU_MERCHANT_KEY=
PAYU_MERCHANT_SALT=
PAYU_ENVIRONMENT=test

# Gym OS registration and password setup emails — server-only. Never prefix with NEXT_PUBLIC_.
# Set SMTP_PASSWORD on the MilesWeb server environment. Do not commit it.
SMTP_HOST=
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_FROM=
SMTP_CAUMAS_TO=
SMTP_PASSWORD=